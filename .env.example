# Copy to .env and adjust. Never commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Asia/Colombo
DEFAULT_CURRENCY=LKR

# --- PostgreSQL (used by docker compose) ---
POSTGRES_USER=fulyn
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fulyn
POSTGRES_PORT=5432

# Backend connection string (psycopg v3 driver). When running the backend
# on the host against the compose database, use localhost as the host.
DATABASE_URL=postgresql+psycopg://fulyn:change-me@127.0.0.1:5432/fulyn

# --- Ollama (runs outside docker compose) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nemotron-3-ultra:cloud

# --- Frontend ---
# Where the Next.js server proxies /api/* requests.
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
